generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum UserRole {
  ADMIN
  TUTOR
  STUDENT
  PARENT
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum LessonDuration {
  MIN_60
  MIN_90
  MIN_120
}

enum PaymentStatus {
  paid
  unpaid
  partial
}

enum StudentStatus {
  active
  inactive
}

// ─── Users ────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  name         String
  role         UserRole   @default(TUTOR)
  status       UserStatus @default(PENDING_APPROVAL)
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  timezone     String     @default("Europe/Chisinau")

  approvedById String?   @map("approved_by")
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  approvedUsers       User[]               @relation("ApprovedBy")
  students            Student[]            @relation("TutorStudents")
  lessons             Lesson[]             @relation("TutorLessons")
  payments            Payment[]            @relation("TutorPayments")
  auditLogs           AuditLog[]
  googleCalendarToken GoogleCalendarToken?
  studentProfile      Student?             @relation("StudentUserAccount")

  @@map("users")
}

// ─── Students ─────────────────────────────────────────────

model Student {
  id      String        @id @default(uuid())
  tutorId String        @map("tutor_id")
  tutor   User          @relation("TutorStudents", fields: [tutorId], references: [id])

  userAccountId String? @unique @map("user_account_id")
  userAccount   User?   @relation("StudentUserAccount", fields: [userAccountId], references: [id])

  name    String
  subject String?
  grade   String?
  status  StudentStatus @default(active)
  phone   String?
  email   String?
  notes   String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  lessons  Lesson[]
  payments Payment[]

  @@index([tutorId])
  @@index([tutorId, status])
  @@map("students")
}

// ─── Lessons ──────────────────────────────────────────────

model Lesson {
  id        String  @id @default(uuid())
  tutorId   String  @map("tutor_id")
  tutor     User    @relation("TutorLessons", fields: [tutorId], references: [id])
  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id])

  date            DateTime
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  isPaid          Boolean  @default(false) @map("is_paid")

  // Immutable snapshots — never join back to Student for historical data
  gradeSnapshot       String? @map("grade_snapshot")
  studentNameSnapshot String  @map("student_name_snapshot")
  subjectSnapshot     String? @map("subject_snapshot")

  googleCalendarEventId String? @unique @map("google_calendar_event_id")
  notes                 String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  payment Payment?

  @@index([tutorId, date])
  @@index([studentId, date])
  @@index([tutorId, deletedAt])
  @@map("lessons")
}

// ─── Payments ─────────────────────────────────────────────

model Payment {
  id        String  @id @default(uuid())
  tutorId   String  @map("tutor_id")
  tutor     User    @relation("TutorPayments", fields: [tutorId], references: [id])
  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  String  @unique @map("lesson_id")
  lesson    Lesson  @relation(fields: [lessonId], references: [id])

  amount Decimal       @db.Decimal(10, 2)
  month  String
  status PaymentStatus @default(unpaid)
  paidAt DateTime?     @map("paid_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  @@index([tutorId, month])
  @@index([studentId, month])
  @@index([tutorId, status])
  @@map("payments")
}

// ─── Google Calendar Tokens ───────────────────────────────

model GoogleCalendarToken {
  id           String    @id @default(uuid())
  tutorId      String    @unique @map("tutor_id")
  tutor        User      @relation(fields: [tutorId], references: [id])

  accessToken  String    @map("access_token")
  refreshToken String    @map("refresh_token")
  expiresAt    DateTime  @map("expires_at")
  googleEmail  String?   @map("google_email")
  scopes       String
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("google_calendar_tokens")
}

// ─── Audit Log ────────────────────────────────────────────

model AuditLog {
  id         BigInt  @id @default(autoincrement())
  userId     String? @map("user_id")
  user       User?   @relation(fields: [userId], references: [id])

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  oldValue   Json?   @map("old_value")
  newValue   Json?   @map("new_value")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}